# No API credentials are required for the local fixture. Uncomment only the
# environment overrides you need; exported OLIST_* values take precedence
# over the corresponding entries in config.yaml.
# OLIST_CONFIG_FILE=config.yaml
# OLIST_API_URL=http://localhost:8000
# OLIST_API_TIMEOUT=20
# OLIST_API_MAX_RETRIES=5
# OLIST_API_RETRY_BACKOFF=2.0
# OLIST_API_RETRY_BACKOFF_MULTIPLIER=2.0
# OLIST_API_PAGE_SIZE=250
# OLIST_API_RESPONSE_DATA_KEY=data
# OLIST_API_RESPONSE_TOTAL_PAGES_KEY=total_pages
# OLIST_API_RESPONSE_TOTAL_RECORDS_KEY=total_records
# OLIST_DATA_DIR=/srv/olist/data
# OLIST_OUTPUT_DIR=/srv/olist/output
# OLIST_CSV_ENCODING=utf-8
# OLIST_DB_QUERY="SELECT * FROM order_items"
# OLIST_DELIVERED_STATUS=delivered
# OLIST_DEFAULT_THEME=dark
# OLIST_DASHBOARD_PORT=8502
# OLIST_SELLER_ACCOUNTABILITY_FILE=seller_accountability.csv
# OLIST_SELLER_MIN_ORDER_COUNT=30
